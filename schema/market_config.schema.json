{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketConfig",
  "description": "Per-market conventions (illustrative, demo).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "asset_class",
    "currency",
    "tz",
    "trading_hours",
    "calendar_note",
    "price_limit_pct",
    "settlement",
    "fee_bps",
    "lot_size",
    "has_cashflow",
    "periods_per_year",
    "synthetic",
    "example_values",
    "display_name_zh"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "asset_class": {
      "enum": [
        "equity",
        "crypto",
        "commodity",
        "fx"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}$"
    },
    "tz": {
      "type": "string"
    },
    "trading_hours": {
      "type": "string"
    },
    "calendar_note": {
      "type": "string"
    },
    "price_limit_pct": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "Example value only; null = no daily limit modelled"
    },
    "settlement": {
      "enum": [
        "T+0",
        "T+1",
        "T+2"
      ]
    },
    "fee_bps": {
      "type": "number",
      "minimum": 0,
      "description": "Example value only (illustrative round-number cost)"
    },
    "lot_size": {
      "type": "integer",
      "minimum": 1
    },
    "has_cashflow": {
      "type": "boolean"
    },
    "periods_per_year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    },
    "synthetic": {
      "const": true
    },
    "example_values": {
      "const": true,
      "description": "fee_bps and price_limit_pct are illustrative example values, not real exchange parameters"
    },
    "display_name_zh": {
      "type": "string",
      "minLength": 1,
      "description": "Chinese display name, e.g. A股 / 港股"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "asset_class": {
            "enum": [
              "crypto",
              "commodity",
              "fx"
            ]
          }
        },
        "required": [
          "asset_class"
        ]
      },
      "then": {
        "properties": {
          "has_cashflow": {
            "const": false
          }
        }
      }
    }
  ]
}
