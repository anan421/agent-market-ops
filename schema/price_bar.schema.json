{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PriceBar",
  "description": "One synthetic daily OHLCV bar (demo).",
  "type": "object",
  "required": [
    "symbol",
    "market",
    "currency",
    "tz",
    "date",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "synthetic"
  ],
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^DEMO[A-Z0-9-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "open": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "high": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "low": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "close": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "volume": {
      "type": "integer",
      "minimum": 0
    },
    "synthetic": {
      "const": true
    },
    "market": {
      "type": "string",
      "enum": [
        "cn_a",
        "crypto",
        "demo",
        "futures",
        "fx",
        "hk",
        "us"
      ],
      "description": "Generated from markets/*.json by scripts/gen_market_enum.py; do not edit by hand"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}$"
    },
    "tz": {
      "type": "string",
      "pattern": "^[A-Za-z_]+(/[A-Za-z_+-]+)*$"
    }
  }
}
